@@ -32,6 +33,87 @@ import { LLMRequestPrep } from "./llm/request"
 
 export const OUTPUT_TOKEN_MAX = ProviderTransform.OUTPUT_TOKEN_MAX
 
+const isEmptyUnknownToolInput = (input: string) => {
+  const value = input.trim()
+  if (value === "" || value === "{}") return true
+  try {
+    const parsed = JSON.parse(value)
+    return !!parsed && typeof parsed === "object" && !Array.isArray(parsed) && Object.keys(parsed).length === 0
+  } catch {
+    return false
+  }
+}
+
+/**
+ * Qwen/OpenRouter occasionally streams an empty, unnamed tool call alongside
+ * valid calls. Buffer only unnamed calls until the provider step finishes,
+ * then discard an empty one iff the same response contained a valid sibling.
+ * Ambiguous/non-empty calls and lone unknown calls pass through unchanged.
+ */
+export const dropEmptyUnknownToolCallsWithValidSibling = (result: LanguageModelV3StreamResult) => {
+  const source = result.stream
+  const stream = new ReadableStream<LanguageModelV3StreamPart>({
+    async start(controller) {
+      const reader = source.getReader()
+      const pending = new Map<string, { parts: LanguageModelV3StreamPart[]; input: string }>()
+      let validToolSeen = false
+
+      const flush = () => {
+        for (const entry of pending.values()) {
+          if (!(validToolSeen && isEmptyUnknownToolInput(entry.input))) {
+            for (const part of entry.parts) controller.enqueue(part)
+          }
+        }
+        pending.clear()
+        validToolSeen = false
+      }
+
+      try {
+        while (true) {
+          const next = await reader.read()
+          if (next.done) break
+          const part = next.value
+
+          if (part.type === "tool-input-start") {
+            if (part.toolName.trim() === "" || part.toolName === "unknown") {
+              pending.set(part.id, { parts: [part], input: "" })
+              continue
+            }
+            validToolSeen = true
+          } else if (part.type === "tool-input-delta" && pending.has(part.id)) {
+            const entry = pending.get(part.id)!
+            entry.parts.push(part)
+            entry.input += part.delta
+            continue
+          } else if (part.type === "tool-input-end" && pending.has(part.id)) {
+            pending.get(part.id)!.parts.push(part)
+            continue
+          } else if (part.type === "tool-call") {
+            if (part.toolName.trim() === "" || part.toolName === "unknown") {
+              const entry = pending.get(part.toolCallId) ?? { parts: [], input: "" }
+              entry.parts.push(part)
+              entry.input = part.input || entry.input
+              pending.set(part.toolCallId, entry)
+              continue
+            }
+            validToolSeen = true
+          }
+
+          if (part.type === "finish") flush()
+          controller.enqueue(part)
+        }
+        flush()
+        controller.close()
+      } catch (error) {
+        controller.error(error)
+      } finally {
+        reader.releaseLock()
+      }
+    },
+  })
+  return { ...result, stream }
+}
+
 export type StreamInput = {
   user: SessionV1.User
   sessionID: string
